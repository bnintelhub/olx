# ========================================================
# OLX ORBIT - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production or env.production
# ========================================================
NODE_ENV=production
PORT=5000

# Client & Admin Web Gateways (Update with your VPS domain or IP)
CLIENT_URL=https://yourdomain.com
ADMIN_URL=https://yourdomain.com/admin
SERVER_URL=https://yourdomain.com

# Database Configuration (Neon Serverless PostgreSQL or Cloud Database)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-solitary-voice-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-solitary-voice-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DB_NAME=neondb
DB_USER=neondb_owner
DB_PORT=5432
# If self-hosting Postgres in Docker container on VPS:
POSTGRES_DB=olx_marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrongDatabasePassword2026!

# Redis Cache, Queue & Session Store
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=

# JWT Authentication & Session Token Secrets (Run: openssl rand -hex 32)
JWT_ACCESS_SECRET=your_super_secure_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS Gateway Configuration (MSG91 / TWILIO / MOCK)
SMS_PROVIDER=MOCK
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45

# Initial Super Admin Provisioning
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSuperAdminSecurePassword2026!
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=10

# Security & Throttling
ENABLE_RATE_LIMIT=true

# Media & Storage Engine Configuration
MEDIA_ROOT=/data/olx-media
MEDIA_PUBLIC_BASE_URL=https://yourdomain.com/media
MAX_FILE_SIZE_BYTES=52428800

# Payment Gateway Configuration (PayU Production)
PAYU_MERCHANT_KEY=your_production_payu_merchant_key
PAYU_MERCHANT_SALT=your_production_payu_merchant_salt
PAYU_BASE_URL=https://secure.payu.in
PAYU_WEBHOOK_SECRET=your_production_payu_webhook_secret
PAYU_ENVIRONMENT=production
PAYU_SUCCESS_URL=https://yourdomain.com/api/v1/payments/verify
PAYU_FAILURE_URL=https://yourdomain.com/api/v1/payments/failure

# Firebase Cloud Messaging & Web Push Notifications
FIREBASE_SERVICE_ACCOUNT_PATH=gen-lang-client-firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_VAPID_KEY=your_vapid_key
VITE_FIREBASE_VAPID_KEY=your_vapid_key

