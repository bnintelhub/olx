# Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/olx_marketplace?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=your_jwt_access_secret_min_10_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_10_chars

# Firebase Admin Push Notification Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=gen-lang-client-0067863163-firebase-adminsdk-fbsvc-3a9115427b.json

# Optional: Firebase Client Config for Service Workers (read from env, never hardcoded)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Rate Limiting (Default: false in development, true in production)
ENABLE_RATE_LIMIT=false
