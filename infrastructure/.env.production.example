# ========================================================
# Platform Environment & Top-Level Application Settings (Production Example)
# ========================================================
NODE_ENV=production
PORT=5000

# Client & Admin Web Gateways
CLIENT_URL=https://yourdomain.com
ADMIN_URL=https://yourdomain.com/admin

# Security & Throttling
ENABLE_RATE_LIMIT=true

# SMS Gateway Configuration (MSG91 / TWILIO / MOCK)
SMS_PROVIDER=MSG91
MOCK_OTP_CODE=
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45

# Initial Super Admin Provisioning
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToAStrongPassword2026!
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=10

