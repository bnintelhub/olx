FROM node:22-alpine AS base
RUN apk add --no-cache openssl libc6-compat
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_OPTIONS="--max-old-space-size=2048"

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* turbo.json .npmrc ./
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared
COPY apps/workers ./apps/workers

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm --filter @olx/database db:generate
RUN pnpm --filter @olx/database build
RUN pnpm --filter @olx/shared build
RUN pnpm --filter @olx/workers build

CMD ["pnpm", "--filter", "@olx/workers", "start"]
