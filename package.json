{
  "name": "olx-monorepo",
  "version": "1.0.0",
  "description": "OLX Marketplace Monorepo with Turborepo & pnpm",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter @olx/admin dev",
    "dev:client": "pnpm --filter @olx/client dev",
    "dev:server": "pnpm --filter @olx/server dev",
    "dev:workers": "pnpm --filter @olx/workers dev",
    "build": "turbo run build",
    "build:admin": "pnpm --filter @olx/admin build",
    "build:client": "pnpm --filter @olx/client build",
    "build:server": "pnpm --filter @olx/server... build",
    "build:workers": "pnpm --filter @olx/workers... build",
    "build:packages": "pnpm --filter \"@olx/*\" build",
    "start:server": "pnpm --filter @olx/server start",
    "start:workers": "pnpm --filter @olx/workers start",
    "test": "turbo run test",
    "test:server": "pnpm --filter @olx/server test",
    "test:load": "pnpm --filter @olx/server test:load",
    "loadtest": "pnpm --filter @olx/server loadtest",
    "db:generate": "pnpm --filter @olx/database db:generate",
    "db:push": "pnpm --filter @olx/database db:push",
    "db:studio": "pnpm --filter @olx/database db:studio",
    "db:seed": "pnpm --filter @olx/database db:seed",
    "db:seed:roles": "pnpm --filter @olx/database run db:seed:roles",
    "seed:admin": "pnpm --filter @olx/database run db:seed:roles",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:db": "docker compose up -d postgres redis",
    "docker:storage": "docker compose up -d minio",
    "docker:infra": "docker compose up -d postgres redis minio",
    "infra": "docker compose up -d postgres redis minio",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "playwright": "^1.65.0",
    "turbo": "^2.4.4"
  }
}
