{
  "name": "bharatmarket-olx",
  "version": "1.0.0",
  "description": "OLX ORBIT — Production-Grade OLX India Classifieds Marketplace",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
