{
  "name": "olx-monorepo",
  "version": "1.0.0",
  "description": "OLX Marketplace Monorepo with Turborepo & pnpm",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:ui": "pnpm --parallel --filter @olx/client --filter @olx/admin run dev",
    "dev:frontend": "pnpm --parallel --filter @olx/client --filter @olx/admin run dev",
    "dev:admin": "pnpm --filter @olx/admin dev",
    "dev:client": "pnpm --filter @olx/client dev",
    "dev:media": "pnpm --filter @olx/media-service dev",
    "dev:server": "pnpm --filter @olx/server dev",
    "dev:workers": "pnpm --filter @olx/workers dev",
    "build": "turbo run build",
    "build:admin": "pnpm --filter @olx/admin build",
    "build:client": "pnpm --filter @olx/client build",
    "build:media": "pnpm --filter @olx/media-service build",
    "build:server": "pnpm --filter @olx/server... build",
    "build:workers": "pnpm --filter @olx/workers... build",
    "build:packages": "pnpm --filter \"@olx/*\" build",
    "start:server": "pnpm --filter @olx/server start",
    "start:workers": "pnpm --filter @olx/workers start",
    "test": "turbo run test",
    "test:server": "pnpm --filter @olx/server test",
    "test:load": "pnpm --filter @olx/server test:load",
    "loadtest": "pnpm --filter @olx/server loadtest",
    "db:generate": "pnpm --filter @olx/database db:generate",
    "db:push": "pnpm --filter @olx/database db:push",
    "db:studio": "pnpm --filter @olx/database db:studio",
    "db:seed": "pnpm --filter @olx/database db:seed",
    "db:seed:roles": "pnpm --filter @olx/database run db:seed:roles",
    "db:refactor-media": "pnpm --filter @olx/server exec tsx ../../scripts/refactor-media-urls.ts",
    "seed:admin": "pnpm --filter @olx/database run db:seed:roles",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "docker compose -f docker-compose.dev.yml build",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:ps": "docker compose -f docker-compose.dev.yml ps",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "playwright": "^1.65.0",
    "turbo": "^2.4.4"
  }
}
