{
  "name": "@olx/database",
  "version": "1.0.0",
  "description": "Prisma client, PostgreSQL schemas, and seeds for OLX Marketplace",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "node scripts/prisma-cli.js generate",
    "db:push": "node scripts/prisma-cli.js db push",
    "db:reset": "node scripts/prisma-cli.js db push --force-reset",
    "db:studio": "node scripts/prisma-cli.js studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:roles": "tsx prisma/seed_all_roles.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}

