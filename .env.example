# ========================================================
# OLX ORBIT Production Environment Variables
# ========================================================

# Database (PostgreSQL 16 in Docker)
DB_NAME=olx_marketplace
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433

# Redis Cache & Sessions (Redis 7 in Docker)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Backend
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/olx_marketplace?schema=public"
JWT_ACCESS_SECRET=bharatmarket_super_secure_jwt_access_secret_key_2026
JWT_REFRESH_SECRET=bharatmarket_super_secure_jwt_refresh_secret_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS Gateway (MSG91 / TWILIO / MOCK)
SMS_PROVIDER=MOCK
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45

# Client URLs
CLIENT_URL=http://localhost:5173

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=10

# Self-Managed Local Media Storage System
MEDIA_ROOT=/data/olx-media
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/media
MEDIA_SERVICE_PORT=5005
MEDIA_SERVICE_URL=http://localhost:5005
