# ========================================================
# OLX ORBIT - ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env for local development
# ========================================================
NODE_ENV=development
PORT=5000

# Client & Admin Web Gateways
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
SERVER_URL=http://localhost:5000

# Database Configuration (Local PostgreSQL)
POSTGRES_DB=olx_marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_NAME=olx_marketplace
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/olx_marketplace?schema=public"

# Redis Cache, Queue & Session Store
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# JWT Authentication & Session Token Secrets
JWT_ACCESS_SECRET=your_development_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_development_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS Gateway Configuration (MSG91 / TWILIO / MOCK)
SMS_PROVIDER=MOCK
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45

# Initial Super Admin Provisioning
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=adminPassword123
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=10

# Security & Throttling
ENABLE_RATE_LIMIT=false

# Media & Storage Engine Configuration
MEDIA_ROOT=./data/olx-media
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/media
MEDIA_SERVICE_PORT=5005
MEDIA_SERVICE_URL=http://localhost:5005
MAX_FILE_SIZE_BYTES=52428800

# Payment Gateway Configuration (PayU Test)
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt
PAYU_BASE_URL=https://test.payu.in
PAYU_WEBHOOK_SECRET=
PAYU_ENVIRONMENT=test
PAYU_SUCCESS_URL=http://localhost/api/v1/payments/verify
PAYU_FAILURE_URL=http://localhost/api/v1/payments/failure

# Firebase Cloud Messaging & Web Push Notifications
FIREBASE_SERVICE_ACCOUNT_PATH=gen-lang-client-firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_VAPID_KEY=your_vapid_key
VITE_FIREBASE_VAPID_KEY=your_vapid_key
