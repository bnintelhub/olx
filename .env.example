# ========================================================
# OLX ORBIT Production Environment Variables
# ========================================================

# Database
DB_ROOT_PASSWORD=super_strong_root_password
DB_NAME=olx_marketplace
DB_USER=olx_user
DB_PASSWORD=olx_secure_password_2026
DB_PORT=3306

# Backend
PORT=5000
NODE_ENV=production
DATABASE_URL="mysql://olx_user:olx_secure_password_2026@mysql:3306/olx_marketplace"
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long

# SMS Gateway (MSG91 / TWILIO / MOCK)
SMS_PROVIDER=MOCK
MOCK_OTP_CODE=123456
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Client URLs
CORS_ORIGIN=http://localhost

# Admin authentication (use ADMIN_PASSWORD_HASH in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=10
